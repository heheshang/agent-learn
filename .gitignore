# ============================================================================
# agent-learn —— Rust workspace（10 个渐进式 RAG 项目）
#
# 组织原则：**按「可再生性」分层**，而不是按「出现顺序」列举。
#
#   第一层：构建产物        —— 重新编译即可
#   第二层：模型缓存        —— 重新下载即可
#   第三层：索引 / 数据     —— 重新生成即可
#   第四层：运行时数据      —— 容器重建即可
#   第五层：本地状态 / 密钥 —— 绝不入库
#
# ⚠️ 加新规则时，先问一句：**这个文件丢了能不能重建？**
#    能 → 忽略；不能 → 入库。
# ============================================================================

# ── 构建产物 ────────────────────────────────────────────────────────────
# Cargo workspace 统一在根目录构建，所以这里只有根级 /target。
# 如果以后拆成独立仓库，再加 `*/target/`。
/target/

# ── 模型缓存（1.7GB+，可重新下载）────────────────────────────────────────
# fastembed / HF 的模型缓存。
.fastembed_cache/

# Docling 版面模型（68MB，可重新下载）。
.models/

# ── 索引产物（可由源文档重新生成）────────────────────────────────────────
# FAISS 向量索引 + BM25 倒排索引。
# ⚠️ 用 `*/index/` 而不是逐个列举 —— 加新项目时不用再改这里。
*/index/

# ── 容器运行时数据（287MB，可 `docker compose down -v` 重建）──────────────
# Milvus standalone 的 etcd / minio / milvus 数据卷。
#
# ⚠️ 这些是**数据库文件**，不是源码 —— 提交进去会让仓库体积暴涨，
#    而且和源码状态完全脱节（每个人本地都不一样）。
10-rag-milvus/docker/volumes/

# Chroma 本地持久化数据。
chroma-data/

# ── 评估报告（可重新生成）────────────────────────────────────────────────
# 每次跑评估都会重写，提交进去只会制造 diff 噪音。
09-rag-eval/reports/

# 抽取出来的图片（重新解析 PDF 即可再生）。
11-rag-advance/assets/

# SQLite 种子数据库（由 data/seed.sql 重新生成）。
#
# ⚠️ 二进制文件进 git 后每次改动都是整文件变更，且 diff 看不出改了什么。
#    文本版的 seed.sql 才是要版本化的东西。
15-agent-sql/data/*.db

# Agent Memory 的运行时存储（会话状态 + 长期记忆）。
#
# ⚠️ 这是**运行时产物** —— 删掉服务就重新积累，不丢源码。
#    里面是用户对话内容，更不该进版本库。
17-agent-memory/data/memory/

# 19-agent-summary 的周报 / 项目方案输出。
#
# ⚠️ 同上 —— 每次跑都会生成带时间戳的新文件，
#    提交进去只会制造 diff 噪音（而且内容取决于当时的模型输出）。
#
#    知识库 `data/kb/*.md` 是**输入**，要入库；
#    `data/reports/` 是**输出**，不入库。
19-agent-summary/data/reports/

# ── 20-agent-preformence-analysis 的 Python 侧产物 ─────────────────────
#
# ⚠️ 三个目录都是**可再生的**：
# - `reports/`  剖析产物（跑一次 `make py-compare` 就重新生成）
# - `.venv/`    uv 虚拟环境（`uv sync` 就重新生成）
# - `__pycache__/` Python 字节码缓存
#
# 剖析产物尤其不该入库：它们**每次跑都不一样**（采样数、时间戳都会变），
# 提交进去只会制造 diff 噪音。
20-agent-preformence-analysis/profiler/reports/
20-agent-preformence-analysis/profiler/.venv/
20-agent-preformence-analysis/profiler/.pytest_cache/
20-agent-preformence-analysis/perf-out/
__pycache__/
*.py[cod]

# ── agent-guide-python（Python 对照项目）的运行时产物 ────────────────
#
# ⚠️ `.venv/` 有几万个文件，**索引它会严重拖慢 Cursor 的文件搜索**，
#    所以这里要显式忽略（不能只靠 venv 自带的 .gitignore）。
agent-guide-python/.venv/
agent-guide-python/.pytest_cache/
agent-guide-python/.ruff_cache/
agent-guide-python/dist/
agent-guide-python/build/

# ── 25-agent-summary 的产物 ──────────────────────────────────────────
#
# ⚠️ `reports/` 是**输出**，不入库。
#    跑一次 `make report-25` 就重新生成。
#
# ⚠️ 压测产物尤其不该入库：它们**每次跑都不一样**
#    （QPS / P99 会随机器负载浮动），提交进去只会制造 diff 噪音。
25-agent-summary/reports/

# ── 本地环境与密钥 ──────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── 编辑器与操作系统 ────────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/

# ── Cursor 本地状态 ─────────────────────────────────────────────────────
# 只忽略 hooks 的运行时状态，保留共享的 hooks 配置本身。
.cursor/hooks/state/

# ── 模糊测试产物（可再生）────────────────────────────────────────────────
# libFuzzer 的语料（corpus）与崩溃样本（artifacts）都是**自动生成**的，
# 提交进去只会制造 diff 噪音。
#
# ⚠️ `fuzz/corpus/` 是 libFuzzer 的**工作语料**（每跑一次就长一堆），
#    `fuzz/artifacts/` 是崩溃复现文件。
#
#    而 `fuzz/fuzz_targets/*.rs` 是**源码**，必须入库。
fuzz/corpus/
fuzz/artifacts/
fuzz/target/

# ⚠️ cargo-fuzz 的构建产物目录名是 `fuzz/target`，
#    但主 workspace 的构建产物在根 `/target` —— 两者不冲突。

# ── 历史备份 ────────────────────────────────────────────────────────────
# ⚠️ `.legacy-git-history/` 里的 git bundle **是有意提交**的 ——
#    它保存了「整合成单仓库」之前 04-rag 的完整历史。
#    所以这里**不**写忽略规则（对已跟踪文件写了也无效，只会造成误导）。
